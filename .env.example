# Copy to .env for docker compose. Generate secrets with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
POSTGRES_PASSWORD=change-me-db-password
# Demo data (admin@tickets.local / demo@tickets.local)
SEED_DATA=true
SEED_ADMIN_PASSWORD=change-me-admin
SEED_USER_PASSWORD=change-me-demo
# Seat hold duration before unpaid holds are released
HOLD_TTL=5m
# mock (no keys needed) or razorpay (test-mode keys below)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional Google sign-in: set SPRING_PROFILES_ACTIVE=google and the two values below
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
